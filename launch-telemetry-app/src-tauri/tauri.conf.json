{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MARV Launch Telemetry",
  "version": "0.1.0",
  "identifier": "com.marv.launch-telemetry",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MARV Launch Telemetry",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
